| Iterators1 Iterator
        { $$ = listCons(AbSyn)($2, $1); }
;

Iterator
: _YY_KW_For ForLhs _YY_KW_In Infixed opt_SuchthatPart_
        { $$ = abNewFor(TPOS($1),$2,$4,$5); }
| _YY_KW_While Infixed
        { $$ = abNewWhile(TPOS($1),TEST($2)); }
;

ForLhs
: Infixed
| _YY_KW_Free Infixed
        { $$ = abNewFree(TPOS($1), $2); }
| _YY_KW_Local Infixed
        { $$ = abNewLocal(TPOS($1), $2); }
| _YY_KW_Fluid Infixed
        { $$ = abNewFluid(TPOS($1), $2); }
;

SuchthatPart
: _YY_KW_Bar Infixed
        { $$ = TEST($2); }
;



Infixed
: InfixedExpr
| InfixedExpr DeclPart
        { $$ = abNewDeclare(APOS($1),$1,$2); }
| Block
;

InfixedExpr
: E11_Op_
| E3
;


E3
: E4
| E3 _YY_KW_And E4
        { $$ = abNewAnd(TPOS($2), TEST($1),TEST($3)); }
| E3 _YY_KW_Or E4
        { $$ = abNewOr(TPOS($2), TEST($1),TEST($3)); }
| E3 LatticeOp E4
        { $$ = abNewInfix(APOS($2),$2,$1,$3); }
;

E4
: E5
| E4 _YY_KW_Has E5
        { $$ = abNewHas(TPOS($2),$1,$3); }
| E4 RelationOp E5
        { $$ = abNewInfix(APOS($2),$2,$1,$3); }
| RelationOp E5
        { $$ = abNewPrefix(APOS($1),$1,$2); }
;

E5
: E6
| E5 SegOp
        { $$ = abNewPostfix(APOS($2),$2,$1); }
| E5 SegOp E6
        { $$ = abNewInfix(APOS($2),$2,$1,$3); }
;

E6
: E7
| E6 PlusOp E7
        { $$ = abNewInfix(APOS($2),$2,$1,$3); }
| PlusOp E7
        { $$ = abNewPrefix(APOS($1),$1,$2); }
;

E7
: E8
| E7 QuotientOp E8
        { $$ = abNewInfix(APOS($2),$2,$1,$3); }
;

E8
: E9
| E8 TimesOp E9
        { $$ = abNewInfix(APOS($2),$2,$1,$3); }
;

E9
: E11_E12_
| E11_E12_ PowerOp E9
        { $$ = abNewInfix(APOS($2),$2,$1,$3); }
;


E11_E12_
: E12
| E11_E12_ _YY_KW_2Colon E12
        { $$ = abNewCoerceTo(TPOS($2),$1,$3); }
| E11_E12_ _YY_KW_At E12
        { $$ = abNewRestrictTo(TPOS($2),$1,$3); }
| E11_E12_ _YY_KW_Pretend E12
        { $$ = abNewPretendTo(TPOS($2),$1,$3); }
;
E11_Op_
: Op
| E11_Op_ _YY_KW_2Colon E12
        { $$ = abNewCoerceTo(TPOS($2),$1,$3); }
| E11_Op_ _YY_KW_At E12
        { $$ = abNewRestrictTo(TPOS($2),$1,$3); }
| E11_Op_ _YY_KW_Pretend E12
        { $$ = abNewPretendTo(TPOS($2),$1,$3); }
;

Type
: E11_E12_
;

E12
: E13
| E13 ArrowOp E12
        { $$ = abNewInfix(APOS($2),$2,$1,$3); }
;

E13
: E14
| E14 _YY_KW_Dollar QualTail
        { $$ = abNewQualify(TPOS($2),$1,$3); }
;

QualTail
: LeftJuxtaposed
| LeftJuxtaposed _YY_KW_Dollar QualTail
        { $$ = abNewQualify(TPOS($2),$1,$3); }
;

OpQualTail
: Molecule
| Molecule _YY_KW_Dollar OpQualTail
        { $$ = abNewQualify(TPOS($2),$1,$3); }
;

E14
: E15
| opt_E14_ _YY_KW_With DeclMolecule
        { $$ = abNewWith(TPOS($2),$1,$3); }
| opt_E14_ _YY_KW_Add DeclMolecule
        { $$ = abNewAdd(TPOS($2),$1,$3); }
| E14 _YY_KW_Except E15
        { $$ = parseDeprecated((TokenTag)_YY_KW_Except, abNewExcept(TPOS($2),$1,$3)); }
| E14 _YY_KW_Throw E15
        { $$ = abNewExcept(TPOS($2),$1,$3); }
;

E15
: Application
;



Op
: ArrowOp
| LatticeOp
| RelationOp
| SegOp
| PlusOp
| QuotientOp
| TimesOp
| PowerOp
;

NakedOp
: UnqualOp_ArrowTok_
| UnqualOp_LatticeTok_
| UnqualOp_RelationTok_
| UnqualOp_SegTok_
| UnqualOp_PlusTok_
| UnqualOp_QuotientTok_
| UnqualOp_TimesTok_
| UnqualOp_PowerTok_
;


ArrowOp:         QualOp_ArrowTok_;
LatticeOp:       QualOp_LatticeTok_;
RelationOp:      QualOp_RelationTok_;
SegOp:           QualOp_SegTok_;
PlusOp:          QualOp_PlusTok_;
QuotientOp:      QualOp_QuotientTok_;
TimesOp:         QualOp_TimesTok_;
PowerOp:         QualOp_PowerTok_;

ArrowTok:   _YY_KW_RArrow | _YY_KW_LArrow | _YY_KW_MapStar ;
LatticeTok: _YY_KW_Vee    | _YY_KW_Wedge ;
RelationTok:_YY_KW_EQ     | _YY_KW_TildeE | _YY_KW_HatE |
                 _YY_KW_GE     | _YY_KW_GT     | _YY_KW_2GT  |
                 _YY_KW_LE     | _YY_KW_LT     | _YY_KW_2LT  |
                 _YY_KW_Is     | _YY_KW_Isnt   | _YY_KW_Case ;
SegTok:     _YY_KW_2Dot   | _YY_KW_By ;
PlusTok:    _YY_KW_Plus   | _YY_KW_Minus  | _YY_KW_PlusMinus ;
QuotientTok:_YY_KW_Mod    | _YY_KW_Quo    | _YY_KW_Rem ;
TimesTok:   _YY_KW_Star   | _YY_KW_Slash  | _YY_KW_Backslash ;
PowerTok:   _YY_KW_2Star  | _YY_KW_Hat ;



Application
: RightJuxtaposed
;

RightJuxtaposed
: Jright_Molecule_
;

LeftJuxtaposed
: Jleft_Molecule_
;


Jright_Atom_
: Jleft_Atom_
| Jleft_Atom_ Jright_Atom_
        { $$ = parseMakeJuxtapose($1,$2); }
| _YY_KW_Not Jright_Atom_
        { $$ = abNewNot(TPOS($1),TEST($2)); }
;
Jright_Molecule_
: Jleft_Molecule_
| Jleft_Molecule_ Jright_Atom_
        { $$ = parseMakeJuxtapose($1,$2); }
| _YY_KW_Not Jright_Atom_
        { $$ = abNewNot(TPOS($1),TEST($2)); }
;


Jleft_Atom_
: Atom
| _YY_KW_Not BlockEnclosure
        { $$ = abNewNot(TPOS($1),TEST($2)); }
| Jleft_Atom_ BlockEnclosure
        { $$ = parseMakeJuxtapose($1,$2); }
| Jleft_Atom_ _YY_KW_Dot BlockMolecule
        { $$ = abNewPrefix(TPOS($2),$1,$3); }
;
Jleft_Molecule_
: Molecule
| _YY_KW_Not BlockEnclosure
        { $$ = abNewNot(TPOS($1),TEST($2)); }
| Jleft_Molecule_ BlockEnclosure
        { $$ = parseMakeJuxtapose($1,$2); }
| Jleft_Molecule_ _YY_KW_Dot BlockMolecule
        { $$ = abNewPrefix(TPOS($2),$1,$3); }
;


Molecule
: Atom
| Enclosure
;

Enclosure
: Parened
| Bracketed
| QuotedIds
;

DeclMolecule
: opt_Application_
| Block
;

BlockMolecule
: Atom
| Enclosure
| Block
;

BlockEnclosure
: Enclosure
| Block
;

Block
: Piled_Expression_
| Curly_Labeled_
;

Parened
: _YY_KW_OParen _YY_KW_CParen
        {
          $$ = abNewParen(TPOS($1), abNewComma0(TPOS($1)));
          abSetEnd($$, TEND($2));
        }
| _YY_KW_OParen Expression _YY_KW_CParen
        { $$ = abNewParen(TPOS($1), $2); abSetEnd($$, TEND($3)); }
;

Bracketed
: _YY_KW_OBrack _YY_KW_CBrack
        {
          $$ = abNewMatchfix(TPOS($1),
                             abNewId(TPOS($1),ssymBracket),
                             abNewComma0(TPOS($1)));
          abSetEnd($$, TEND($2));
        }
| _YY_KW_OBrack Expression _YY_KW_CBrack
        {
          $$ = abNewMatchfix(TPOS($1),
                             abNewId(TPOS($1),ssymBracket),
                             $2);
          abSetEnd($$, TEND($3));
        }
;

QuotedIds
: _YY_KW_Quote _YY_KW_Quote
        {
          $$ = abNewMatchfix(TPOS($1),
                             abNewId(TPOS($1),ssymEnum),
                             abNewComma0(TPOS($1)));
          abSetEnd($$, TEND($2));
        }
| _YY_KW_Quote Names _YY_KW_Quote
        {
          $$ = abNewMatchfix(TPOS($1),
                             abNewId(TPOS($1),ssymEnum),
                             $2);
          abSetEnd($$, TEND($3));
        }
;
Names
: enlist1_Name__YY_KW_Comma_AB_Comma_
;


Atom
: Id
| Literal
;

Name
: Id
| NakedOp
;

Id
: _YY_TK_Id
        { $$ = abNewOfToken(AB_Id,    $1); }
| _YY_KW_Sharp
        { $$ = abNewOfToken(AB_Id,    $1); }
| _YY_KW_Tilde
        { $$ = abNewOfToken(AB_Id,    $1); }
;


Literal
: _YY_TK_Int
        { $$ = abNewOfToken(AB_LitInteger, $1); }
| _YY_TK_Float
        { $$ = abNewOfToken(AB_LitFloat,   $1); }
| _YY_TK_String
        { $$ = abNewOfToken(AB_LitString,  $1); }
;



Nothing
:
        { $$ = abZip; }
;


UnqualOp_PowerTok_
: PowerTok
        { $$ = abNewOfToken(AB_Id, $1); }
;
UnqualOp_TimesTok_
: TimesTok
        { $$ = abNewOfToken(AB_Id, $1); }
;
UnqualOp_QuotientTok_
: QuotientTok
        { $$ = abNewOfToken(AB_Id, $1); }
;
UnqualOp_PlusTok_
: PlusTok
        { $$ = abNewOfToken(AB_Id, $1); }
;
UnqualOp_SegTok_
: SegTok
        { $$ = abNewOfToken(AB_Id, $1); }
;
UnqualOp_RelationTok_
: RelationTok
        { $$ = abNewOfToken(AB_Id, $1); }
;
UnqualOp_LatticeTok_
: LatticeTok
        { $$ = abNewOfToken(AB_Id, $1); }
;
UnqualOp_ArrowTok_
: ArrowTok
        { $$ = abNewOfToken(AB_Id, $1); }
;


QualOp_PowerTok_
: PowerTok
        { $$ = abNewOfToken(AB_Id, $1); }
| PowerTok _YY_KW_Dollar OpQualTail
        { $$ = abNewQualify(TPOS($1), abNewOfToken(AB_Id, $1), $3); }
;
QualOp_TimesTok_
: TimesTok
        { $$ = abNewOfToken(AB_Id, $1); }
| TimesTok _YY_KW_Dollar OpQualTail
        { $$ = abNewQualify(TPOS($1), abNewOfToken(AB_Id, $1), $3); }
;
QualOp_QuotientTok_
: QuotientTok
        { $$ = abNewOfToken(AB_Id, $1); }
| QuotientTok _YY_KW_Dollar OpQualTail
        { $$ = abNewQualify(TPOS($1), abNewOfToken(AB_Id, $1), $3); }
;
QualOp_PlusTok_
: PlusTok
        { $$ = abNewOfToken(AB_Id, $1); }
| PlusTok _YY_KW_Dollar OpQualTail
        { $$ = abNewQualify(TPOS($1), abNewOfToken(AB_Id, $1), $3); }
;
QualOp_SegTok_
: SegTok
        { $$ = abNewOfToken(AB_Id, $1); }
| SegTok _YY_KW_Dollar OpQualTail
        { $$ = abNewQualify(TPOS($1), abNewOfToken(AB_Id, $1), $3); }
;
QualOp_RelationTok_
: RelationTok
        { $$ = abNewOfToken(AB_Id, $1); }
| RelationTok _YY_KW_Dollar OpQualTail
        { $$ = abNewQualify(TPOS($1), abNewOfToken(AB_Id, $1), $3); }
;
QualOp_LatticeTok_
: LatticeTok
        { $$ = abNewOfToken(AB_Id, $1); }
| LatticeTok _YY_KW_Dollar OpQualTail
        { $$ = abNewQualify(TPOS($1), abNewOfToken(AB_Id, $1), $3); }
;
QualOp_ArrowTok_
: ArrowTok
        { $$ = abNewOfToken(AB_Id, $1); }
| ArrowTok _YY_KW_Dollar OpQualTail
        { $$ = abNewQualify(TPOS($1), abNewOfToken(AB_Id, $1), $3); }
;


opt_Application_
: Nothing
| Application
;
opt_E14_
: Nothing
| E14
;
opt_SuchthatPart_
: Nothing
| SuchthatPart
;
opt_Collection_
: Nothing
| Collection
;
opt_Name_
: Nothing
| Name
;
opt_FromPart_
: Nothing
| FromPart
;
opt_Sig_
: Nothing
| Sig
;
opt_Labeled_
: Nothing
| Labeled
;




Doc_Expression_
: PreDocument Expression PostDocument
        {
          $$ = $2;
          if($3) $$ = abNewDocumented(APOS($3),$$,$3);
          if($1) $$ = abNewDocumented(APOS($$),$$,$1);
        }
;

PreDocument
: PreDocumentList
        { $$ = abNewDocTextOfList($1); listFree(Token)($1); }
;

PostDocument
: PostDocumentList
        { $$ = abNewDocTextOfList($1); listFree(Token)($1); }
;

PreDocumentList
: Nothing
        { $$ = listNil(Token); }
| _YY_TK_PreDoc PreDocumentList
        { $$ = listCons(Token)($1, $2); }
;

PostDocumentList
: Nothing
        { $$ = listNil(Token); }
| _YY_TK_PostDoc PostDocumentList
        { $$ = listCons(Token)($1, $2); }
;



enlist1_Name__YY_KW_Comma_AB_Comma_
: enlister1_Name__YY_KW_Comma_

        { $$ = abOneOrNewOfList(AB_Comma, $1); listFree(AbSyn)($1); }
;
enlist1_InfixedExpr__YY_KW_Comma_AB_Comma_
: enlister1_InfixedExpr__YY_KW_Comma_

        { $$ = abOneOrNewOfList(AB_Comma, $1); listFree(AbSyn)($1); }
;
enlist1_CommaItem__YY_KW_Comma_AB_Comma_
: enlister1_CommaItem__YY_KW_Comma_

        { $$ = abOneOrNewOfList(AB_Comma, $1); listFree(AbSyn)($1); }
;
enlist1_Infixed__YY_KW_Comma_AB_Comma_
: enlister1_Infixed__YY_KW_Comma_

        { $$ = abOneOrNewOfList(AB_Comma, $1); listFree(AbSyn)($1); }
;




enlister1_Name__YY_KW_Comma_
: Name
        { $$ = listCons(AbSyn)($1, listNil(AbSyn) ); }
| enlister1_Name__YY_KW_Comma_ _YY_KW_Comma Name
        { $$ = listCons(AbSyn)($3, $1); }
;
enlister1_InfixedExpr__YY_KW_Comma_
: InfixedExpr
        { $$ = listCons(AbSyn)($1, listNil(AbSyn) ); }
| enlister1_InfixedExpr__YY_KW_Comma_ _YY_KW_Comma InfixedExpr
        { $$ = listCons(AbSyn)($3, $1); }
;
enlister1_CommaItem__YY_KW_Comma_
: CommaItem
        { $$ = listCons(AbSyn)($1, listNil(AbSyn) ); }
| enlister1_CommaItem__YY_KW_Comma_ _YY_KW_Comma CommaItem
        { $$ = listCons(AbSyn)($3, $1); }
;
enlister1_Infixed__YY_KW_Comma_
: Infixed
        { $$ = listCons(AbSyn)($1, listNil(AbSyn) ); }
| enlister1_Infixed__YY_KW_Comma_ _YY_KW_Comma Infixed
        { $$ = listCons(AbSyn)($3, $1); }
;




enlist1a_Labeled__YY_KW_Semicolon_AB_Sequence_
: enlister1a_Labeled__YY_KW_Semicolon_
        { $$ = abOneOrNewOfList(AB_Sequence, $1); listFree(AbSyn)($1); }
;


enlister1a_Labeled__YY_KW_Semicolon_
: Labeled
        { $$ = listCons(AbSyn)($1, listNil(AbSyn) ); }
| enlister1a_Labeled__YY_KW_Semicolon_ _YY_KW_Semicolon Labeled
        { $$ = listCons(AbSyn)($3, $1); }
| enlister1a_Labeled__YY_KW_Semicolon_ _YY_KW_Semicolon
        { $$ = $1; }
;



Piled_Expression_
: _YY_KW_SetTab PileContents_Expression_ _YY_KW_BackTab
        { $$ = abOneOrNewOfList(AB_Sequence,$2); listFree(AbSyn)($2); }
;


Curly_Labeled_
: _YY_KW_OCurly CurlyContents_Labeled_ _YY_KW_CCurly
        { $$ = $2; abSetPos($$, TPOS($1)); abSetEnd($$, TEND($3)); }
;


PileContents_Expression_
: Doc_Expression_
        { $$ = listCons(AbSyn)($1, listNil(AbSyn)); }
| PileContents_Expression_ _YY_KW_BackSet Doc_Expression_
        { $$ = listCons(AbSyn)($3, $1); }
| error _YY_KW_BackSet Doc_Expression_
        { yyerrok; $$ = listCons(AbSyn)($3, listNil(AbSyn)); }
;


CurlyContents_Labeled_
: CurlyContentsList_Labeled_
        { $$ = abOneOrNewOfList(AB_Sequence,$1); listFree(AbSyn)($1); }
;


CurlyContentsList_Labeled_
: CurlyContent1_Labeled_
| CurlyContent1_Labeled_ CurlyContentB_Labeled_
        { $$ = listCons(AbSyn)($2, $1); }
;


CurlyContent1_Labeled_
: Nothing
        { $$ = listNil(AbSyn); }
| CurlyContent1_Labeled_ CurlyContentA_Labeled_
        { $$ = listCons(AbSyn)($2, $1); }
;


CurlyContentA_Labeled_
: CurlyContentB_Labeled_ _YY_KW_Semicolon PostDocument
        { $$ = $1; if($3) $$ = abNewDocumented(APOS($3),$$,$3); }
| error _YY_KW_Semicolon PostDocument
        { yyerrok; $$ = abNewNothing(TPOS($2)); }
;


CurlyContentB_Labeled_
: PreDocument Labeled PostDocument
        {
          $$ = $2;
          if($1) $$ = abNewDocumented(APOS($1),$$,$1);
          if($3) $$ = abNewDocumented(APOS($$),$$,$3);
        }
;
