CBool GcCanBlacklist         = false;
int  GcDoShow               = 0;
static CBool GcWorkStats     = false;

/* Set GC_FRUGAL to enable more reticent heap growth */
static CBool GcIsFrugal      = false;


void
stoInitFromEnvironment(void) {
        MutString s;

        if (s = osGetEnv("GC_FRUGAL"),    s)  GcIsFrugal           = true;

        if (s = osGetEnv("GC_GEFN"),      s)  GcEffectiveFactorNum = atoi(s);
        if (s = osGetEnv("GC_GEFD"),      s)  GcEffectiveFactorDen = atoi(s);
        if (s = osGetEnv("GC_GGFN"),      s)  GcGrowthFactorNum    = atoi(s);
        if (s = osGetEnv("GC_GGFD"),      s)  GcGrowthFactorDen    = atoi(s);

        if (s = osGetEnv("GC_FINDFREE"),  s)  GcDoFindFree         = true;
        if (s = osGetEnv("GC_CLASSIFY"),  s)  GcDoClassify         = true;
        if (s = osGetEnv("GC_BLACKLIST"), s)  GcCanBlacklist       = true;

        if (s = osGetEnv("GC_DETAIL"),    s)  GcDoShow             = stoShowArgs(s);
        if (s = osGetEnv("ALDOR_GC_STATS"), s)  GcWorkStats           = true;
}


