long GcEffectiveFactorNum   = 3;
long GcEffectiveFactorDen   = 10;
/* double GcGrowthFactor    = 1.4;    Grow the heap by this much if a Gc fails.*/
long GcGrowthFactorNum      = 14;
long GcGrowthFactorDen      = 10;
