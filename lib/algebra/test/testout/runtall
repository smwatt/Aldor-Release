runt1() {
    echo ">> == $1 std ==============================="
    diff $1.out $newdir/$1.aldorStd.out
    echo ">> == $1 debug ==============================="
    diff $1.out $newdir/$1.aldorDebug.out
    echo ">> == $1 gmp ==============================="
    diff $1.out $newdir/$1.aldorGmp.out
}
runt() {
    runt1 $* 2>&1
}
